# Managed for the Anywhere WAN test service.
server {
    listen 80;
    server_name @DOMAIN@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/anywhere-wan-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 308 https://@DOMAIN@$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    access_log /var/log/nginx/anywhere-wan-domain.access.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/anywhere-wan-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /easytier {
        if ($http_upgrade !~* ^websocket$) { return 426; }
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host localhost;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass http://127.0.0.1:31483/;
    }

    location ^~ /ws/ {
        if ($http_upgrade !~* ^websocket$) { return 426; }
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/anywhere-wan/ca.crt;
        proxy_buffering off;
        proxy_connect_timeout 30s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass https://127.0.0.1:18443;
    }

    location ~ ^/api/sessions/[a-f0-9-]+/stream$ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/anywhere-wan/ca.crt;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 30s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass https://127.0.0.1:18443;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/anywhere-wan/ca.crt;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        proxy_pass https://127.0.0.1:18443;
    }
}
