# 监听地址：保持 127.0.0.1，只让 cloudflared 隧道访问
HOST=127.0.0.1
PORT=3210
# 数据目录（SQLite 数据库）
DATA_DIR=~/.anywhere-coding
# 允许 AI 工作的根目录，多个用逗号分隔
WORKSPACE_ROOTS=~/workspace
# 可选：使用本机安装的 claude 可执行文件而不是 SDK 内置的
# CLAUDE_PATH=/usr/local/bin/claude
# 可选：使用本机安装的 codex 可执行文件
# CODEX_PATH=/usr/local/bin/codex

# 网络代理：如果你的终端通过代理访问 Anthropic / OpenAI（例如在 ~/.bashrc 里 export 了 http_proxy），
# 这里也要配置。systemd 服务不会读取 ~/.bashrc，没有代理时 Claude 会报 403 Request not allowed。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
